---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { languages, routes, useTranslations, type Key, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const segments: [string, Key, Key, string][] = [
  ['home', 'solar.home', 'solar.home.text', 'tejado-paneles'],
  ['building', 'solar.business', 'solar.business.text', 'instalacion-azotea'],
  ['battery', 'solar.offgrid', 'solar.offgrid.text', 'banner-paneles'],
];
const benefits: [string, Key, Key][] = [
  ['sun', 'b.saving', 'b.saving.text'],
  ['leaf', 'b.clean', 'b.clean.text'],
  ['wrench', 'b.easy', 'b.easy.text'],
];
---
<Base lang={lang} title={t('nav.solar')} description={t('solar.text')} path={routes.solar}>
  <section class="relative isolate overflow-hidden bg-deep text-white">
    <img src="/images/banner-ventajas.webp" alt="" width="1900" height="624" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-deep-dark/75"></div>
    <div class="mx-auto max-w-6xl px-4 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sun">{t('solar.eyebrow')}</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight sm:text-5xl">{t('solar.title')}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">{t('solar.text')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl space-y-16 px-4 py-20">
    {segments.map(([icon, title, text, img], i) => (
      <article class="grid items-center gap-8 md:grid-cols-2">
        <img src={`/images/${img}.webp`} alt="" loading="lazy" class:list={['aspect-[4/3] w-full rounded-2xl object-cover shadow-md', i % 2 === 1 && 'md:order-2']} />
        <div>
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-sun/15 text-sun-dark"><Icon name={icon} class="h-7 w-7" /></span>
          <h2 class="mt-4 text-3xl text-deep">{t(title)}</h2>
          <p class="mt-3 text-lg leading-relaxed text-ink/75">{t(text)}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-sky">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl text-deep">{t('home.why.title')}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {benefits.map(([icon, title, text]) => (
          <div class="rounded-2xl bg-white p-6 ring-1 ring-line">
            <Icon name={icon} class="h-8 w-8 text-sun-dark" />
            <h3 class="mt-3 text-lg text-deep">{t(title)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/75">{t(text)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
