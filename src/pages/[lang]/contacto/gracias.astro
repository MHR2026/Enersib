---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={t('thanks.title')} noindex>
  <section class="mx-auto max-w-2xl px-4 py-32 text-center">
    <Icon name="check" class="mx-auto h-16 w-16 text-leaf" />
    <h1 class="mt-6 text-4xl text-deep">{t('thanks.title')}</h1>
    <p class="mt-4 text-lg text-ink/75">{t('thanks.text')}</p>
    <a href={`/${lang}/`} class="mt-10 inline-block rounded-full bg-deep px-7 py-3 font-semibold text-white">{t('thanks.back')}</a>
  </section>
</Base>
