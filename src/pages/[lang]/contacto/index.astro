---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { company, departments, languages, mapEmbed, mapsUrl, routes, tel, useTranslations, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const input = 'mt-1 w-full rounded-lg border border-line bg-white px-4 py-3 font-normal focus:border-deep focus:outline-none focus:ring-2 focus:ring-deep/20';
---
<Base lang={lang} title={t('nav.contact')} description={t('contact.text')} path={routes.contact}>
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sun-dark">{t('contact.eyebrow')}</p>
      <h1 class="mt-3 text-4xl text-deep sm:text-5xl">{t('contact.title')}</h1>
      <p class="mt-4 text-lg text-ink/75">{t('contact.text')}</p>

      <h2 class="mt-10 text-sm font-semibold uppercase tracking-widest text-ink/60">{t('contact.departments')}</h2>
      <ul class="mt-4 space-y-3">
        {departments.map(([key, person, n]) => (
          <li class="flex items-center justify-between gap-3 rounded-xl border border-line px-4 py-3">
            <span><span class="font-semibold">{t(key)}</span> <span class="text-ink/60">· {person}</span></span>
            <a href={tel(n)} class="inline-flex shrink-0 items-center gap-2 font-semibold text-deep hover:text-sun-dark"><Icon name="phone" class="h-4 w-4" />{n}</a>
          </li>
        ))}
      </ul>
      <dl class="mt-8 space-y-4">
        <div class="flex gap-3"><Icon name="pin" class="h-6 w-6 shrink-0 text-sun-dark" /><dd>{company.address}<br />{company.city}</dd></div>
        <div class="flex gap-3"><Icon name="mail" class="h-6 w-6 shrink-0 text-sun-dark" /><dd><a class="hover:text-sun-dark" href={`mailto:${company.email}`}>{company.email}</a></dd></div>
      </dl>
    </div>

    <div id="formulario" class="scroll-mt-28 rounded-2xl bg-sky p-6 ring-1 ring-line sm:p-10">
      <p id="form-error" hidden class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{t('form.error')} <a class="underline" href={`mailto:${company.email}`}>{company.email}</a></p>
      <form action="/api/contacto.php" method="post" class="grid gap-5 sm:grid-cols-2">
        <input type="hidden" name="lang" value={lang} />
        <div class="hidden" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="block text-sm font-semibold">{t('form.name')} *<input class={input} name="name" required autocomplete="name" /></label>
        <label class="block text-sm font-semibold">{t('form.email')} *<input class={input} name="email" type="email" required autocomplete="email" /></label>
        <label class="block text-sm font-semibold">{t('form.phone')}<input class={input} name="phone" type="tel" autocomplete="tel" /></label>
        <label class="block text-sm font-semibold">{t('form.subject')} *<input class={input} name="subject" required /></label>
        <label class="block text-sm font-semibold sm:col-span-2">{t('form.message')} *<textarea class={input} name="message" rows="6" required></textarea></label>
        <label class="flex items-start gap-3 text-sm sm:col-span-2">
          <input type="checkbox" name="consent" value="1" required class="mt-1 accent-[var(--color-deep)]" />
          <span>{t('form.consent')} <a href={`/${lang}/legal/`} target="_blank" class="underline">{t('form.privacy')}</a>.</span>
        </label>
        <button type="submit" class="rounded-full bg-deep px-7 py-3 font-semibold text-white hover:bg-deep-dark sm:col-span-2 sm:justify-self-start">{t('form.send')}</button>
      </form>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20">
    <!-- Mapa: Google Maps solo se carga si el visitante lo pide (sin cookies de terceros por defecto) -->
    <div class="relative min-h-[360px] overflow-hidden rounded-2xl bg-sky ring-1 ring-line" data-map={mapEmbed(lang)}>
      <img src="/images/banner-paneles.webp" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-40" />
      <div class="relative flex min-h-[360px] items-center justify-center p-6"><div class="flex max-w-sm flex-col items-center gap-3 rounded-2xl bg-white/95 p-6 text-center shadow-lg">
        <button type="button" class="inline-flex items-center gap-2 rounded-full bg-deep px-6 py-3 font-semibold text-white hover:bg-deep-dark"><Icon name="pin" class="h-5 w-5" />{t('map.button')}</button>
        <a href={mapsUrl} target="_blank" rel="noopener" class="text-sm font-semibold text-deep underline">{t('cta.directions')} ↗</a>
        <p class="max-w-xs text-xs text-ink/70">{t('map.note')}</p>
      </div></div>
    </div>
  </section>

  <script>
    if (new URLSearchParams(location.search).has('error')) document.getElementById('form-error')!.hidden = false;
    document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
      box.querySelector('button')?.addEventListener('click', () => {
        box.innerHTML = `<iframe src="${box.dataset.map}" title="Google Maps" class="absolute inset-0 h-full w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
      });
    });
  </script>
</Base>
