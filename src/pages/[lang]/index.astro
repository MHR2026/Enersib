---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { languages, routes, useTranslations, type Key, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const services: [string, Key, Key][] = [
  ['ruler', 's.study', 's.study.text'],
  ['helmet', 's.install', 's.install.text'],
  ['doc', 's.grants', 's.grants.text'],
  ['flame', 's.boilers', 's.boilers.text'],
];
const benefits: [string, Key, Key][] = [
  ['sun', 'b.saving', 'b.saving.text'],
  ['leaf', 'b.clean', 'b.clean.text'],
  ['wrench', 'b.easy', 'b.easy.text'],
];
---
<Base lang={lang}>
  <section class="relative isolate overflow-hidden bg-deep text-white">
    <img src="/images/hero-paneles.webp" alt="" width="1920" height="1080" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-deep-dark via-deep-dark/80 to-deep-dark/10"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sun">{t('home.eyebrow')}</p>
      <h1 class="mt-4 max-w-2xl text-4xl leading-[1.05] sm:text-6xl">{t('home.title')}</h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">{t('home.text')}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={`/${lang}/${routes.contact}`} class="rounded-full bg-sun px-6 py-3 font-semibold text-deep hover:bg-sun-dark">{t('cta.quote')}</a>
        <a href={`/${lang}/${routes.solar}`} class="rounded-full bg-white/10 px-6 py-3 font-semibold ring-1 ring-white/40 hover:bg-white/20">{t('nav.solar')}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sun-dark">{t('home.services.eyebrow')}</p>
    <h2 class="mt-3 text-3xl text-deep sm:text-4xl">{t('home.services.title')}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map(([icon, title, text]) => (
        <article class="rounded-2xl border border-line bg-white p-6 shadow-sm">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-sun/15 text-sun-dark"><Icon name={icon} class="h-7 w-7" /></span>
          <h3 class="mt-4 text-xl text-deep">{t(title)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/75">{t(text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-sky">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 lg:grid-cols-2">
      <div class="grid grid-cols-2 gap-4">
        <img src="/images/instalacion-tejado.webp" alt="" width="1200" height="900" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md" />
        <img src="/images/instalacion-azotea.webp" alt="" width="860" height="480" loading="lazy" class="mt-10 aspect-[4/5] w-full rounded-2xl object-cover shadow-md" />
      </div>
      <div>
        <h2 class="text-3xl text-deep sm:text-4xl">{t('home.why.title')}</h2>
        <ul class="mt-8 space-y-6">
          {benefits.map(([icon, title, text]) => (
            <li class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-deep text-sun"><Icon name={icon} /></span>
              <div><h3 class="text-lg text-deep">{t(title)}</h3><p class="mt-1 text-ink/75">{t(text)}</p></div>
            </li>
          ))}
        </ul>
        <a href={`/${lang}/${routes.solar}`} class="mt-8 inline-block rounded-full border border-deep px-6 py-3 font-semibold text-deep hover:bg-deep hover:text-white">{t('cta.more')}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-leaf">{t('boilers.eyebrow')}</p>
      <h2 class="mt-3 text-3xl text-deep sm:text-4xl">{t('boilers.title')}</h2>
      <p class="mt-4 text-lg text-ink/75">{t('boilers.text')}</p>
      <div class="mt-6 grid grid-cols-4 items-center gap-3">
        {['okofen', 'vigas', 'heizomat', 'easypell'].map((b) => <img src={`/images/logo-${b}.webp`} alt={b} width="600" height="345" loading="lazy" class="w-full rounded-lg bg-white ring-1 ring-line" />)}
      </div>
      <a href={`/${lang}/${routes.boilers}`} class="mt-8 inline-block rounded-full border border-deep px-6 py-3 font-semibold text-deep hover:bg-deep hover:text-white">{t('cta.more')}</a>
    </div>
    <img src="/images/okofen-sistema.webp" alt="ÖkoFEN" width="1600" height="988" loading="lazy" class="w-full rounded-2xl object-cover ring-1 ring-line" />
  </section>

  <CtaBand lang={lang} />
</Base>
